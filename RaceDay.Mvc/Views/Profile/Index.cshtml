@model RaceDay.Mvc.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>My Profile</h1>

        <p class="text-muted">
            Manage your RaceDay personal information and profile picture.
        </p>
    </div>

    <div class="row g-4">

        <!-- ============================================= -->
        <!-- PROFILE PICTURE -->
        <!-- ============================================= -->

        <div class="col-lg-4">

            <div class="card shadow-sm h-100">
                <div class="card-body text-center">

                    <h5 class="card-title mb-4">
                        Profile Picture
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl"
                             alt="Profile picture"
                             class="rounded-circle border mb-3"
                             style="width: 160px;
                        height: 160px;
                        object-fit: cover;" />

                        <!-- MANAGE PICTURE BUTTON -->

                        <div class="mt-2">

                            <button type="button"
                                    class="btn btn-outline-primary w-100"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#pictureOptions"
                                    aria-expanded="false"
                                    aria-controls="pictureOptions">
                                Manage Picture
                            </button>

                        </div>

                        <!-- REPLACE / REMOVE OPTIONS -->

                        <div class="collapse mt-3"
                             id="pictureOptions">

                            <div class="border rounded p-3">

                                <p class="fw-semibold mb-3">
                                    Would you like to replace or
                                    remove this picture?
                                </p>

                                <div class="d-flex gap-2
                                    justify-content-center
                                    flex-wrap">

                                    <button type="button"
                                            class="btn btn-primary"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#replacePictureSection"
                                            aria-expanded="false"
                                            aria-controls="replacePictureSection">
                                        Replace
                                    </button>

                                    <form asp-controller="Profile"
                                          asp-action="RemovePicture"
                                          method="post"
                                          class="m-0"
                                          onsubmit="return confirm('Are you sure you want to remove your profile picture?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger">
                                            Remove
                                        </button>

                                    </form>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            onclick="closeAllPictureOptions()">
                                        Cancel
                                    </button>

                                </div>

                            </div>

                        </div>

                        <!-- REPLACE PICTURE FORM -->

                        <div class="collapse mt-3"
                             id="replacePictureSection">

                            <div class="border rounded p-3">

                                <h6 class="fw-bold mb-3">
                                    Replace Profile Picture
                                </h6>

                                <form asp-controller="Profile"
                                      asp-action="UploadPicture"
                                      method="post"
                                      enctype="multipart/form-data">

                                    @Html.AntiForgeryToken()

                                    <div class="mb-3 text-start">

                                        <label for="profilePicture"
                                               class="form-label">
                                            Choose New Profile Picture
                                        </label>

                                        <input type="file"
                                               id="replacementProfilePictureInput"
                                               name="profilePicture"
                                               class="form-control"
                                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                               required />

                                        <div class="form-text">
                                            JPG, JPEG, PNG or WEBP.
                                            Maximum file size: 5 MB.
                                        </div>

                                    </div>

                                    <button type="submit"
                                            id="saveNewProfilePictureButton"
                                            class="btn btn-primary me-2"
                                            disabled>
                                        Save New Picture
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary w-100"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#replacePictureSection">
                                        Cancel
                                    </button>

                                </form>

                            </div>

                        </div>
                    }
                    else
                    {
                        <!-- NO PROFILE PICTURE -->

                        <div class="rounded-circle border
                            d-flex align-items-center
                            justify-content-center
                            mx-auto mb-3 bg-light"
                             style="width: 160px;
                            height: 160px;">

                            <span class="text-muted">
                                No Photo
                            </span>

                        </div>

                        <!-- FIRST-TIME PICTURE UPLOAD -->

                        <form asp-controller="Profile"
                              asp-action="UploadPicture"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div class="mb-3 text-start">

                                <label for="profilePicture"
                                       class="form-label">
                                    Choose Profile Picture
                                </label>

                                <input type="file"
                                       id="newProfilePictureInput"
                                       name="profilePicture"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       required />

                                <div class="form-text">
                                    JPG, JPEG, PNG or WEBP.
                                    Maximum file size: 5 MB.
                                </div>

                            </div>

                            <button type="submit"
                                    id="uploadProfilePictureButton"
                                    class="btn btn-primary"
                                    disabled>
                                Upload Picture
                            </button>

                        </form>
                    }

                </div>
            </div>

        </div>

        <!-- ============================================= -->
        <!-- PERSONAL INFORMATION -->
        <!-- ============================================= -->

        <div class="col-lg-8">

            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h5 class="card-title mb-4">
                        Personal Information
                    </h5>

                    <form asp-controller="Profile"
                          asp-action="Update"
                          method="post"
                          id="profileInformationForm">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input asp-for="UserId"
                               type="hidden" />

                        <!-- First Name / Last Name -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label">
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label">
                                </label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- Email -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                            <div class="form-text">
                                Your login email address cannot be
                                changed from this page.
                            </div>

                        </div>

                        <!-- Phone / Date of Birth -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="PhoneNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="DateOfBirth"
                                       class="form-label">
                                </label>

                                <input asp-for="DateOfBirth"
                                       class="form-control"
                                       type="date" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- Save Button -->

                        <button type="submit"
                                id="profileSaveButton"
                                class="btn btn-primary"
                                disabled>
                            Save Changes
                        </button>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

<script>
    function closeAllPictureOptions() {

        const replaceSection =
            document.getElementById(
                'replacePictureSection');

        const pictureOptions =
            document.getElementById(
                'pictureOptions');

        if (replaceSection) {

            const replaceCollapse =
                bootstrap.Collapse.getOrCreateInstance(
                    replaceSection,
                    {
                        toggle: false
                    });

            replaceCollapse.hide();
        }

        if (pictureOptions) {

            const optionsCollapse =
                bootstrap.Collapse.getOrCreateInstance(
                    pictureOptions,
                    {
                        toggle: false
                    });

            optionsCollapse.hide();
        }
    }
</script>

<script>
    document.addEventListener(
        'DOMContentLoaded',
        function() {

            const profileForm =
                document.getElementById(
                    'profileInformationForm');

            const saveButton =
                document.getElementById(
                    'profileSaveButton');

            if (!profileForm || !saveButton) {
                return;
            }

            const editableFields =
                Array.from(
                    profileForm.querySelectorAll(
                        'input:not([type="hidden"]):not([readonly]), select, textarea'
                    )
                );

            const originalValues =
                editableFields.map(field => ({
                    field: field,
                    value: field.value
                }));

            function profileHasChanges() {

                return originalValues.some(
                    item =>
                        item.field.value !==
                        item.value
                );
            }

            function updateSaveButton() {

                saveButton.disabled =
                    !profileHasChanges();
            }

            editableFields.forEach(field => {

                field.addEventListener(
                    'input',
                    updateSaveButton);

                field.addEventListener(
                    'change',
                    updateSaveButton);
            });

            profileForm.addEventListener(
                'submit',
                function(event) {

                    if (!profileHasChanges()) {
                        event.preventDefault();
                        return;
                    }

                    const confirmed =
                        window.confirm(
                            'Are you sure you want to save these profile changes?'
                        );

                    if (!confirmed) {
                        event.preventDefault();
                    }
                });

            updateSaveButton();
        });
</script>

<script>
    document.addEventListener(
        'DOMContentLoaded',
        function() {

            const fileInput =
                document.getElementById(
                    'newProfilePictureInput');

            const uploadButton =
                document.getElementById(
                    'uploadProfilePictureButton');

            if (!fileInput || !uploadButton) {
                return;
            }

            function updateUploadButton() {

                uploadButton.disabled =
                    fileInput.files.length === 0;
            }

            fileInput.addEventListener(
                'change',
                updateUploadButton);

            updateUploadButton();
        });
</script>

<script>
    document.addEventListener(
        'DOMContentLoaded',
        function() {

            const replacementInput =
                document.getElementById(
                    'replacementProfilePictureInput');

            const saveNewPictureButton =
                document.getElementById(
                    'saveNewProfilePictureButton');

            if (!replacementInput ||
                !saveNewPictureButton) {
                return;
            }

            function updateReplacementButton() {

                saveNewPictureButton.disabled =
                    replacementInput.files.length === 0;
            }

            replacementInput.addEventListener(
                'change',
                updateReplacementButton);

            updateReplacementButton();
        });
</script>