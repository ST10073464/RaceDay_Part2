@model RaceDay.Contracts.Auth.LoginRequest

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">
                        RaceDay Login
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Sign in to access your RaceDay account.
                    </p>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          autocomplete="off">

                        @Html.AntiForgeryToken()

                        @* Preserve the selected event during login *@
                        @if (ViewBag.EventId != null)
                        {
                            <input type="hidden"
                                   name="eventId"
                                   value="@ViewBag.EventId" />
                        }

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   id="Email"
                                   placeholder="Enter your email address"
                                   autocomplete="username"
                                   value="" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   id="Password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   value="" />

                            <div class="form-check mt-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="showLoginPassword" />

                                <label class="form-check-label"
                                       for="showLoginPassword">
                                    Show password
                                </label>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- LOGIN BUTTON -->
                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                Login
                            </button>
                        </div>

                        <!-- CANCEL BUTTON -->
                        <div class="d-grid mt-3">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                    <hr class="my-4" />

                    <p class="text-center mb-0">
                        Don't have an account?

                        <a asp-controller="Account"
                           asp-action="Register"
                           asp-route-eventId="@ViewBag.EventId">
                            Create an account
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const emailInput =
                    document.getElementById("Email");

                const passwordInput =
                    document.getElementById("Password");

                const showPasswordCheckbox =
                    document.getElementById(
                        "showLoginPassword");

                function clearLoginForm() {

                    if (emailInput) {
                        emailInput.value = "";
                    }

                    if (passwordInput) {
                        passwordInput.value = "";
                        passwordInput.type = "password";
                    }

                    if (showPasswordCheckbox) {
                        showPasswordCheckbox.checked = false;
                    }
                }

                // Always start Login with empty fields.
                clearLoginForm();

                // Clear delayed browser autofill once.
                window.setTimeout(
                    clearLoginForm,
                    300);

                // Show / hide password.
                if (passwordInput &&
                    showPasswordCheckbox) {

                    showPasswordCheckbox.addEventListener(
                        "change",
                        function () {

                            passwordInput.type =
                                this.checked
                                    ? "text"
                                    : "password";
                        });
                }
            });
    </script>
}
