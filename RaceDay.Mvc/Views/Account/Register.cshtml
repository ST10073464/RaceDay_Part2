@model RaceDay.Contracts.Auth.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">
                        Create RaceDay Account
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Register as a participant to access RaceDay events.
                    </p>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post"
                          autocomplete="off">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       id="FirstName"
                                       placeholder="Enter your first name"
                                       autocomplete="off"
                                       value="" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       id="LastName"
                                       placeholder="Enter your last name"
                                       autocomplete="off"
                                       value="" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   id="Email"
                                   placeholder="Enter your email address"
                                   autocomplete="off"
                                   value="" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   id="Password"
                                   placeholder="Minimum 8 characters"
                                   autocomplete="new-password"
                                   value="" />

                            <div class="form-check mt-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="showRegisterPassword" />

                                <label class="form-check-label"
                                       for="showRegisterPassword">
                                    Show password
                                </label>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Password must contain at least 8 characters.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="form-control"
                                   id="PhoneNumber"
                                   placeholder="Enter your phone number"
                                   autocomplete="off"
                                   value="" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Date of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control"
                                   id="DateOfBirth"
                                   autocomplete="off"
                                   value="" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                You must be at least 16 years old
                                to create a RaceDay account.
                            </div>

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                Create Account
                            </button>

                        </div>

                    </form>

                    <hr class="my-4" />

                    <p class="text-center mb-0">
                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">
                            Log in
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const firstNameInput =
                    document.getElementById("FirstName");

                const lastNameInput =
                    document.getElementById("LastName");

                const emailInput =
                    document.getElementById("Email");

                const passwordInput =
                    document.getElementById("Password");

                const phoneInput =
                    document.getElementById("PhoneNumber");

                const dateOfBirthInput =
                    document.getElementById("DateOfBirth");

                const showPasswordCheckbox =
                    document.getElementById(
                        "showRegisterPassword");

                function clearRegistrationForm() {

                    if (firstNameInput) {
                        firstNameInput.value = "";
                    }

                    if (lastNameInput) {
                        lastNameInput.value = "";
                    }

                    if (emailInput) {
                        emailInput.value = "";
                    }

                    if (passwordInput) {
                        passwordInput.value = "";
                        passwordInput.type = "password";
                    }

                    if (phoneInput) {
                        phoneInput.value = "";
                    }

                    if (dateOfBirthInput) {
                        dateOfBirthInput.value = "";
                    }

                    if (showPasswordCheckbox) {
                        showPasswordCheckbox.checked = false;
                    }
                }

                // Always start Register with empty fields.
                clearRegistrationForm();

                // Clear delayed browser autofill once.
                window.setTimeout(
                    clearRegistrationForm,
                    300);

                // Show / hide password.
                if (passwordInput &&
                    showPasswordCheckbox) {

                    showPasswordCheckbox.addEventListener(
                        "change",
                        function () {

                            passwordInput.type =
                                this.checked
                                    ? "text"
                                    : "password";
                        });
                }
            });
    </script>
}