@model RaceDay.Mvc.Models.EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between
                        align-items-center mb-4">

                <div>
                    <h1 class="fw-bold">Edit Event</h1>

                    <p class="text-muted mb-0">
                        Update the details of your RaceDay event.
                    </p>
                </div>

                <a asp-controller="Organiser"
                   asp-action="MyEvents"
                   class="btn btn-outline-secondary">
                    Back to My Events
                </a>

            </div>

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-controller="Organiser"
                          asp-action="EditEvent"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="EventId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="EventName"
                                   class="form-label">
                            </label>

                            <input asp-for="EventName"
                                   class="form-control" />

                            <span asp-validation-for="EventName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="EventDate"
                                       class="form-label">
                                </label>

                                <input asp-for="EventDate"
                                       class="form-control" />

                                <span asp-validation-for="EventDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Location"
                                       class="form-label">
                                </label>

                                <input asp-for="Location"
                                       class="form-control" />

                                <span asp-validation-for="Location"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="DistanceKm"
                                       class="form-label">
                                </label>

                                <input asp-for="DistanceKm"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01" />

                                <span asp-validation-for="DistanceKm"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="EventType"
                                       class="form-label">
                                </label>

                                <select asp-for="EventType"
                                        class="form-select">

                                    <option value="">
                                        Select event type
                                    </option>

                                    <option value="Run">
                                        Run
                                    </option>

                                    <option value="Walk">
                                        Walk
                                    </option>

                                    <option value="Cycle">
                                        Cycle
                                    </option>

                                </select>

                                <span asp-validation-for="EventType"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="BannerImageUrl"
                                   class="form-label">
                            </label>

                            <input asp-for="BannerImageUrl"
                                   class="form-control"
                                   placeholder="Optional image URL" />

                            <span asp-validation-for="BannerImageUrl"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Optional. Enter a URL for the event banner image.
                            </div>

                        </div>

                        <div class="d-flex justify-content-between
                            align-items-center gap-2">

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-controller="Organiser"
                                   asp-action="ManageCategories"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-primary">
                                    Manage Categories
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="EventParticipants"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-primary">
                                    Participants
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="EventResults"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-success">
                                    Event Results
                                </a>

                            </div>


                            <div class="d-flex gap-2">

                                <a asp-controller="Organiser"
                                   asp-action="MyEvents"
                                   class="btn btn-outline-secondary">

                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn btn-primary">

                                    Save Changes

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
