@model RaceDay.Mvc.Models.EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between
                        align-items-center mb-4">

                <div>
                    <h1 class="fw-bold">Edit Event</h1>

                    <p class="text-muted mb-0">
                        Update the details of your RaceDay event.
                    </p>
                </div>

                <a asp-controller="Organiser"
                   asp-action="MyEvents"
                   class="btn btn-outline-secondary">
                    Back to My Events
                </a>

            </div>

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-controller="Organiser"
                          asp-action="EditEvent"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="EventId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="EventName"
                                   class="form-label">
                            </label>

                            <input asp-for="EventName"
                                   class="form-control" />

                            <span asp-validation-for="EventName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="EventDate"
                                       class="form-label">
                                </label>

                                <input asp-for="EventDate"
                                       class="form-control" />

                                <span asp-validation-for="EventDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Location"
                                       class="form-label">
                                </label>

                                <input asp-for="Location"
                                       class="form-control" />

                                <span asp-validation-for="Location"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="DistanceKm"
                                       class="form-label">
                                </label>

                                <input asp-for="DistanceKm"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01" />

                                <span asp-validation-for="DistanceKm"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="EventType"
                                       class="form-label">
                                </label>

                                <select asp-for="EventType"
                                        class="form-select">

                                    <option value="">
                                        Select event type
                                    </option>

                                    <option value="Run">
                                        Run
                                    </option>

                                    <option value="Walk">
                                        Walk
                                    </option>

                                    <option value="Cycle">
                                        Cycle
                                    </option>

                                </select>

                                <span asp-validation-for="EventType"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Event Banner
                            </label>

                            <input asp-for="BannerImageUrl"
                                   type="hidden" />

                            @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.BannerImageUrl"
                                         alt="@Model.EventName event banner"
                                         class="img-fluid rounded border"
                                         style="max-height: 260px; width: 100%; object-fit: cover;" />
                                </div>

                                <div class="form-text">
                                    Current event banner. Use the banner upload section below
                                    to replace this image.
                                </div>
                            }
                            else
                            {
                                <div class="border rounded bg-light text-muted text-center p-4">
                                    No event banner uploaded.
                                </div>

                                <div class="form-text">
                                    You can upload a banner image after saving the event.
                                </div>
                            }

                        </div>

                        <div class="mt-4">

                            <div class="d-flex gap-2 flex-wrap mb-4">

                                <a asp-controller="Organiser"
                                   asp-action="ManageCategories"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-primary">
                                    Manage Categories
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="EventParticipants"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-primary">
                                    Participants
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="EventResults"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-success">
                                    Event Results
                                </a>

                            </div>

                            <hr />

                            <div class="d-flex justify-content-end gap-2 mt-3">

                                <a asp-controller="Organiser"
                                   asp-action="MyEvents"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Save Changes
                                </button>

                            </div>

                        </div>

                    </form>

                    <hr class="my-4" />

                    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                    {
                        <div class="mb-2">

                            <h5 class="fw-bold">
                                Event Banner
                            </h5>

                            <p class="text-muted">
                                A banner is already uploaded for this event.
                            </p>

                            <!-- MANAGE BANNER BUTTON -->

                            <button type="button"
                                    class="btn btn-outline-success"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#bannerOptions"
                                    aria-expanded="false"
                                    aria-controls="bannerOptions">
                                Manage Banner
                            </button>

                            <!-- REPLACE / REMOVE / CANCEL OPTIONS -->

                            <div class="collapse mt-3"
                                 id="bannerOptions">

                                <div class="border rounded p-3">

                                    <p class="fw-semibold mb-3">
                                        Would you like to replace or remove
                                        this banner?
                                    </p>

                                    <div class="d-flex gap-2 flex-wrap">

                                        <button type="button"
                                                class="btn btn-success"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#replaceBannerSection"
                                                aria-expanded="false"
                                                aria-controls="replaceBannerSection">
                                            Replace
                                        </button>

                                        <form asp-controller="Organiser"
                                              asp-action="RemoveEventBanner"
                                              method="post"
                                              class="m-0"
                                              onsubmit="return confirm('Are you sure you want to remove this event banner?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="eventId"
                                                   value="@Model.EventId" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger">
                                                Remove
                                            </button>

                                        </form>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                onclick="closeAllBannerOptions()">
                                            Cancel
                                        </button>

                                    </div>

                                </div>

                            </div>

                            <!-- REPLACE BANNER FORM -->

                            <div class="collapse mt-3"
                                 id="replaceBannerSection">

                                <div class="border rounded p-3">

                                    <h6 class="fw-bold">
                                        Replace Event Banner
                                    </h6>

                                    <p class="text-muted">
                                        Choose a new JPG, JPEG, PNG or WEBP image.
                                        Maximum file size: 5 MB.
                                    </p>

                                    <form asp-controller="Organiser"
                                          asp-action="UploadEventBanner"
                                          method="post"
                                          enctype="multipart/form-data">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="eventId"
                                               value="@Model.EventId" />

                                        <div class="mb-3">

                                            <label for="bannerImage"
                                                   class="form-label">
                                                Choose New Banner Image
                                            </label>

                                            <input type="file"
                                                   id="bannerImage"
                                                   name="bannerImage"
                                                   class="form-control"
                                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                                   required />

                                        </div>

                                        <button type="submit"
                                                class="btn btn-success me-2">
                                            Save New Banner
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#replaceBannerSection">
                                            Cancel
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="mb-2">

                            <h5 class="fw-bold">
                                Upload Event Banner
                            </h5>

                            <p class="text-muted">
                                Upload a JPG, JPEG, PNG or WEBP image.
                                Maximum file size: 5 MB.
                            </p>

                            <form asp-controller="Organiser"
                                  asp-action="UploadEventBanner"
                                  method="post"
                                  enctype="multipart/form-data">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="eventId"
                                       value="@Model.EventId" />

                                <div class="mb-3">

                                    <label for="bannerImage"
                                           class="form-label">
                                        Choose Banner Image
                                    </label>

                                    <input type="file"
                                           id="bannerImage"
                                           name="bannerImage"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           required />

                                </div>

                                <button type="submit"
                                        class="btn btn-success">
                                    Upload Banner
                                </button>

                            </form>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    function closeAllBannerOptions() {

        const replaceSection =
            document.getElementById(
                'replaceBannerSection');

        const bannerOptions =
            document.getElementById(
                'bannerOptions');

        if (replaceSection) {

            const replaceCollapse =
                bootstrap.Collapse.getOrCreateInstance(
                    replaceSection,
                    {
                        toggle: false
                    });

            replaceCollapse.hide();
        }

        if (bannerOptions) {

            const optionsCollapse =
                bootstrap.Collapse.getOrCreateInstance(
                    bannerOptions,
                    {
                        toggle: false
                    });

            optionsCollapse.hide();
        }
    }
</script>
