@model RaceDay.Mvc.Models.EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between
                align-items-center mb-4">

                <div>
                    <h1 class="fw-bold">Edit Event</h1>

                    <p class="text-muted mb-0">
                        Update the details of your RaceDay event.
                    </p>
                </div>

                <a asp-controller="Organiser"
                   asp-action="MyEvents"
                   class="btn btn-outline-secondary">
                    Back to My Events
                </a>

            </div>

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <form asp-controller="Organiser"
                          asp-action="EditEvent"
                          method="post"
                          id="editEventForm">

                        @Html.AntiForgeryToken()

                        <input asp-for="EventId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="EventName"
                                   class="form-label">
                            </label>

                            <input asp-for="EventName"
                                   class="form-control" />

                            <span asp-validation-for="EventName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="EventDate"
                                       class="form-label">
                                </label>

                                <input asp-for="EventDate"
                                       class="form-control" />

                                <span asp-validation-for="EventDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Location"
                                       class="form-label">
                                </label>

                                <input asp-for="Location"
                                       class="form-control" />

                                <span asp-validation-for="Location"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="DistanceKm"
                                       class="form-label">
                                </label>

                                <input asp-for="DistanceKm"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01" />

                                <span asp-validation-for="DistanceKm"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="EventType"
                                       class="form-label">
                                </label>

                                <select asp-for="EventType"
                                        class="form-select">

                                    <option value="">
                                        Select event type
                                    </option>

                                    <option value="Run">
                                        Run
                                    </option>

                                    <option value="Walk">
                                        Walk
                                    </option>

                                    <option value="Cycle">
                                        Cycle
                                    </option>

                                </select>

                                <span asp-validation-for="EventType"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Event Banner
                            </label>

                            <input asp-for="BannerImageUrl"
                                   type="hidden" />

                            @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.BannerImageUrl"
                                         alt="@Model.EventName event banner"
                                         class="img-fluid rounded border"
                                         style="max-height: 260px; width: 100%; object-fit: cover;" />
                                </div>

                                <div class="form-text">
                                    Current event banner. Use the banner upload section below
                                    to replace this image.
                                </div>
                            }
                            else
                            {
                                <div class="border rounded bg-light text-muted text-center p-4">
                                    No event banner uploaded.
                                </div>

                                <div class="form-text">
                                    You can upload a banner image after saving the event.
                                </div>
                            }

                        </div>

                        <div class="mt-4">

                            <div class="d-flex gap-2 flex-wrap mb-4">

                                <a asp-controller="Organiser"
                                   asp-action="ManageCategories"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-primary">
                                    Manage Categories
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="EventParticipants"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-primary">
                                    Participants
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="EventResults"
                                   asp-route-eventId="@Model.EventId"
                                   class="btn btn-outline-success">
                                    Event Results
                                </a>

                            </div>

                            <hr />

                            <div class="d-flex justify-content-end gap-2 mt-3">

                                <a asp-controller="Organiser"
                                   asp-action="MyEvents"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                                <button type="submit"
                                        id="eventSaveButton"
                                        class="btn btn-primary"
                                        disabled>
                                    Save Changes
                                </button>

                            </div>

                        </div>

                    </form>

                    <hr class="my-4" />

                    <h5 class="fw-bold">Event Banner</h5>
                    <p class="text-muted">Replace the banner using a URL or a file upload, or remove the existing banner.</p>

                    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                    {
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-outline-success"
                                    data-bs-toggle="collapse" data-bs-target="#bannerEditor"
                                    aria-controls="bannerEditor" aria-expanded="false">
                                Manage Banner
                            </button>
                            <form asp-controller="Organiser" asp-action="RemoveEventBanner" method="post"
                                  onsubmit="return confirm('Remove this event banner?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <button type="submit" class="btn btn-outline-danger">Remove Banner</button>
                            </form>
                        </div>
                    }

                    <div class="@(string.IsNullOrWhiteSpace(Model.BannerImageUrl) ? "" : "collapse")" id="bannerEditor">
                        <div class="border rounded p-3">
                            <h6 class="fw-bold">@(string.IsNullOrWhiteSpace(Model.BannerImageUrl) ? "Add Event Banner" : "Replace Event Banner")</h6>
                            <p class="text-muted small">Choose one method. A URL displays an externally hosted image; a file is uploaded to Azure Storage.</p>

                            <form asp-controller="Organiser" asp-action="SaveEventBanner" method="post"
                                  enctype="multipart/form-data" id="bannerUpdateForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.EventId" />

                                <div class="mb-3">
                                    <label for="newBannerImageUrl" class="form-label">Banner Image URL</label>
                                    <input type="url" id="newBannerImageUrl" name="bannerImageUrl"
                                           class="form-control" placeholder="https://example.com/banner.jpg"
                                           pattern="https://.*" />
                                    <div class="form-text">Optional. Paste a direct HTTPS image URL.</div>
                                </div>

                                <p class="text-center text-muted fw-semibold">OR</p>

                                <div class="mb-3">
                                    <label for="newBannerImage" class="form-label">Upload Banner Image</label>
                                    <input type="file" id="newBannerImage" name="bannerImage"
                                           class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                                    <div class="form-text">JPG, JPEG, PNG or WebP. Maximum 5 MB.</div>
                                </div>

                                <div id="bannerChoiceError" class="text-danger small mb-2" role="alert"></div>
                                <button type="submit" id="saveBannerButton" class="btn btn-success" disabled>
                                    Save New Banner
                                </button>
                                @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                                {
                                    <button type="button" class="btn btn-outline-secondary ms-2"
                                            data-bs-toggle="collapse" data-bs-target="#bannerEditor">
                                        Cancel
                                    </button>
                                }
                            </form>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('editEventForm');
        const save = document.getElementById('eventSaveButton');
        if (form && save) {
            const fields = Array.from(form.querySelectorAll('input:not([type="hidden"]), select, textarea'));
            const initial = fields.map(field => field.value);
            const changed = () => fields.some((field, i) => field.value !== initial[i]);
            const update = () => { save.disabled = !changed(); };
            fields.forEach(field => { field.addEventListener('input', update); field.addEventListener('change', update); });
            form.addEventListener('submit', function (e) {
                if (!changed() || !confirm('Are you sure you want to save these event changes?')) e.preventDefault();
            });
            update();
        }

        const bannerForm = document.getElementById('bannerUpdateForm');
        const url = document.getElementById('newBannerImageUrl');
        const file = document.getElementById('newBannerImage');
        const button = document.getElementById('saveBannerButton');
        const error = document.getElementById('bannerChoiceError');
        if (!bannerForm || !url || !file || !button || !error) return;
        const updateBanner = () => {
            const hasUrl = url.value.trim().length > 0;
            const hasFile = file.files.length > 0;
            error.textContent = hasUrl && hasFile ? 'Choose either a URL or a file, not both.' : '';
            button.disabled = (hasUrl === hasFile);
        };
        url.addEventListener('input', updateBanner);
        file.addEventListener('change', updateBanner);
        bannerForm.addEventListener('submit', function (e) {
            updateBanner();
            if (button.disabled) e.preventDefault();
        });
        updateBanner();
    });
</script>
