@model RaceDay.Mvc.Models.EventParticipantsViewModel

@{
    ViewData["Title"] = "Event Participants";

    int totalParticipants = Model.Enrolments?.Count ?? 0;

    int confirmedParticipants = Model.Enrolments?.Count(e =>
        string.Equals(
            e.EnrolmentStatus,
            "Confirmed",
            StringComparison.OrdinalIgnoreCase)) ?? 0;

    int cancelledParticipants = Model.Enrolments?.Count(e =>
        string.Equals(
            e.EnrolmentStatus,
            "Cancelled",
            StringComparison.OrdinalIgnoreCase)) ?? 0;

    // Navigation source:
    // EditEvent = opened from My Events > Edit Event
    // Dashboard = opened from Organiser Dashboard
    string returnTo = ViewBag.ReturnTo as string
        ?? Context.Request.Query["returnTo"].ToString();

    bool fromEditEvent = string.Equals(
        returnTo,
        "EditEvent",
        StringComparison.OrdinalIgnoreCase);
}

<div class="container py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-2">Event Participants</h1>

            <h5 class="mb-2">@Model.EventName</h5>

            <p class="text-muted mb-0">
                @Model.EventDate.ToString("dd MMMM yyyy")
                &bull;
                @Model.Location
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Organiser"
               asp-action="ManageCategories"
               asp-route-eventId="@Model.EventId"
               asp-route-returnTo="EventParticipants"
               class="btn btn-outline-primary">
                Categories
            </a>

            <a asp-controller="Organiser"
               asp-action="EventResults"
               asp-route-eventId="@Model.EventId"
               class="btn btn-outline-success">
                Event Results
            </a>

            @if (fromEditEvent)
            {
                <a asp-controller="Organiser"
                   asp-action="EditEvent"
                   asp-route-id="@Model.EventId"
                   class="btn btn-outline-secondary">
                    Back to Edit Event
                </a>
            }
            else
            {
                <a asp-controller="Organiser"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Dashboard
                </a>
            }

        </div>
    </div>

    <!-- PARTICIPANT SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Total Enrolments
                    </p>
                    <h2 class="fw-bold mb-0">
                        @totalParticipants
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Confirmed
                    </p>
                    <h2 class="fw-bold mb-0 text-success">
                        @confirmedParticipants
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Cancelled
                    </p>
                    <h2 class="fw-bold mb-0">
                        @cancelledParticipants
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- PARTICIPANT LIST -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <h5 class="fw-bold mb-0">
                    Participant Enrolments

                    <span class="badge bg-primary ms-2">
                        @totalParticipants
                    </span>
                </h5>

                <input type="search"
                       id="participantSearch"
                       class="form-control"
                       style="max-width: 300px;"
                       placeholder="Search participants..."
                       aria-label="Search participants" />

            </div>
        </div>

        <div class="card-body">

            @if (Model.Enrolments == null ||
                 Model.Enrolments.Count == 0)
            {
                <div class="text-center py-5">

                    <h5 class="fw-bold">
                        No Participants Yet
                    </h5>

                    <p class="text-muted mb-0">
                        No participants have enrolled in this event yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle"
                           id="participantsTable">

                        <thead class="table-light">
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                                <th>Enrolment ID</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrolment in Model.Enrolments)
                            {
                                <tr class="participant-row">

                                    <td>
                                        <strong>
                                            @enrolment.ParticipantName
                                        </strong>

                                        <div class="small text-muted">
                                            Participant ID:
                                            @enrolment.ParticipantId
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @enrolment.CategoryName
                                        </span>
                                    </td>

                                    <td>
                                        @enrolment.EnrolmentDate.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (string.Equals(
                                            enrolment.EnrolmentStatus,
                                            "Confirmed",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (string.Equals(
                                            enrolment.EnrolmentStatus,
                                            "Cancelled",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @enrolment.EnrolmentStatus
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @enrolment.EnrolmentId
                                    </td>

                                    <td class="text-end">

                                        @if (string.Equals(
                                            enrolment.EnrolmentStatus,
                                            "Confirmed",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a asp-controller="Organiser"
                                               asp-action="RecordResult"
                                               asp-route-eventId="@Model.EventId"
                                               asp-route-enrolmentId="@enrolment.EnrolmentId"
                                               class="btn btn-sm btn-outline-primary">
                                                Record Result
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Not available
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>

                </div>

                <p id="noSearchResults"
                   class="text-center text-muted py-3 d-none"
                   role="status">
                    No participants match your search.
                </p>
            }

        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("participantSearch");

        const rows =
            document.querySelectorAll(".participant-row");

        const noResults =
            document.getElementById("noSearchResults");

        if (!searchInput || rows.length === 0) {
            return;
        }

        searchInput.addEventListener("input", function () {

            const searchTerm =
                this.value.trim().toLowerCase();

            let visibleCount = 0;

            rows.forEach(function (row) {

                const rowText =
                    row.textContent.toLowerCase();

                const matches =
                    rowText.includes(searchTerm);

                row.classList.toggle("d-none", !matches);

                if (matches) {
                    visibleCount++;
                }
            });

            if (noResults) {
                noResults.classList.toggle(
                    "d-none",
                    visibleCount > 0
                );
            }
        });
    });
</script>
