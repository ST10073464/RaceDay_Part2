@model List<RaceDay.Mvc.Models.EventViewModel>
@{
    ViewData["Title"] = "All Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>All Events</h1>
        <p class="text-muted">Browse events created by all organisers. This page is read-only.</p>
    </div>
    <a asp-controller="Organiser" asp-action="MyEvents" class="btn btn-outline-primary">My Events</a>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">No events are currently available.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Distance (km)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var raceEvent in Model)
                {
                    <tr>
                        <td>@raceEvent.EventName</td>
                        <td>@raceEvent.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@raceEvent.Location</td>
                        <td>@raceEvent.EventType</td>
                        <td>@raceEvent.DistanceKm</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
