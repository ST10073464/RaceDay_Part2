@model RaceDay.Mvc.Models.EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Unable to enrol.</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <a asp-controller="Home"
       asp-action="MyEnrolments"
       class="btn btn-outline-secondary mb-4">
        ← Back to My Enrolments
    </a>

    <div class="card shadow-sm mb-4">

        @if (!string.IsNullOrWhiteSpace(Model.Event.BannerImageUrl))
        {
            <img src="@Model.Event.BannerImageUrl"
                 class="card-img-top"
                 alt="@Model.Event.EventName banner"
                 style="max-height: 350px; object-fit: cover;" />
        }

        <div class="card-body">

            <h2 class="card-title mb-3">
                @Model.Event.EventName
            </h2>

            @if (!string.IsNullOrWhiteSpace(Model.Event.Description))
            {
                <p class="card-text">
                    @Model.Event.Description
                </p>
            }

            <div class="row mt-4">

                <div class="col-md-6 mb-3">
                    <strong>Type</strong>
                    <div>@Model.Event.EventType</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Date</strong>
                    <div>
                        @Model.Event.EventDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Location</strong>
                    <div>@Model.Event.Location</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Distance</strong>
                    <div>@Model.Event.DistanceKm km</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Event ID</strong>
                    <div>@Model.Event.EventId</div>
                </div>

                @if (Model.ParticipantAgeOnEventDate.HasValue)
                {
                    <div class="col-md-6 mb-3">
                        <strong>Your age on event day</strong>
                        <div>
                            @Model.ParticipantAgeOnEventDate.Value years
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>

    <div class="d-flex justify-content-between
        align-items-center mb-3">

        <h3 class="mb-0">
            Event Categories
        </h3>

        @if (Model.ParticipantAgeOnEventDate.HasValue)
        {
            <span class="badge bg-light text-dark border">
                Age on event day:
                @Model.ParticipantAgeOnEventDate.Value
            </span>
        }

    </div>

    @if (!Model.ParticipantAgeOnEventDate.HasValue)
    {
        <div class="alert alert-warning">
            Your date of birth is required before RaceDay can
            determine which event category you are eligible for.
            Please update your profile before enrolling.
        </div>
    }

    @if (Model.Categories == null ||
         Model.Categories.Count == 0)
    {
        <div class="alert alert-info">
            No categories are currently available for this event.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var category in Model.Categories)
            {
                bool hasAge =
                    Model.ParticipantAgeOnEventDate.HasValue;

                int participantAge =
                    Model.ParticipantAgeOnEventDate ?? 0;

                bool isAgeEligible =
                    hasAge &&
                    participantAge >= 16 &&
                    participantAge >= category.MinAge &&
                    participantAge <= category.MaxAge;

                bool isEnrolledInThisCategory =
                    Model.ExistingEnrolment != null &&
                    Model.ExistingEnrolment.CategoryId ==
                        category.CategoryId;

                <div class="col-md-6 mb-4">

                    <div class="card h-100 shadow-sm
                        @(isAgeEligible
    ? "border-success"
    : "border-secondary bg-light")">

                        <div class="card-body d-flex
                            flex-column">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                mb-2">

                                <h5 class="card-title mb-0">
                                    @category.CategoryName
                                </h5>

                                @if (isAgeEligible)
                                {
                                    <span class="badge bg-success">
                                        Eligible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Not Eligible
                                    </span>
                                }

                            </div>

                            <p class="card-text mb-1">
                                <strong>Distance:</strong>
                                @category.DistanceKm km
                            </p>

                            <p class="card-text mb-3">
                                <strong>Age:</strong>
                                @category.MinAge–@category.MaxAge
                            </p>

                            @if (!hasAge)
                            {
                                <div class="alert alert-secondary mt-auto mb-0">
                                    <strong>
                                        Date of birth required
                                    </strong>

                                    <div class="small mt-1">
                                        Update your profile so RaceDay can
                                        determine your eligibility.
                                    </div>
                                </div>
                            }
                            else if (!isAgeEligible)
                            {
                                <div class="mt-auto">

                                    <button type="button"
                                            class="btn btn-secondary w-100"
                                            disabled>
                                        Not Eligible —
                                        Ages @category.MinAge–@category.MaxAge
                                    </button>

                                    @if (category.MaxAge <= 17)
                                    {
                                        <div class="alert alert-info mt-3 mb-0">
                                            <strong>
                                                Youth category
                                            </strong>

                                            <div class="small mt-1">
                                                This category is available
                                                to participants aged
                                                @category.MinAge–@category.MaxAge
                                                on event day.
                                                Invite a younger friend or
                                                peer in this age group to
                                                register for RaceDay.
                                            </div>
                                        </div>
                                    }
                                    else if (category.MinAge >= 18)
                                    {
                                        <div class="alert alert-info mt-3 mb-0">
                                            <strong>
                                                Adult category
                                            </strong>

                                            <div class="small mt-1">
                                                This category is available
                                                to participants aged
                                                @category.MinAge–@category.MaxAge
                                                on event day.
                                                Invite an older friend or
                                                family member in this age
                                                group to register for RaceDay.
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small mt-2">
                                            This category is available only
                                            to participants aged
                                            @category.MinAge–@category.MaxAge
                                            on event day.
                                        </div>
                                    }

                                </div>
                            }
                            else if (isEnrolledInThisCategory)
                            {
                                <div class="mt-auto">

                                    <button type="button"
                                            class="btn btn-success w-100"
                                            disabled>
                                        ✓ Enrolled
                                    </button>

                                    <div class="text-success small mt-2">
                                        You are registered for this category.
                                    </div>

                                </div>
                            }
                            else if (Model.ExistingEnrolment != null)
                            {
                                <div class="mt-auto">

                                    <button type="button"
                                            class="btn btn-outline-secondary w-100"
                                            disabled>
                                        Another Category Selected
                                    </button>

                                    <div class="text-muted small mt-2">
                                        You already have an active
                                        registration for another eligible
                                        category in this event.
                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="mt-auto">

                                    <form asp-controller="Home"
                                          asp-action="Enrol"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="eventId"
                                               value="@Model.Event.EventId" />

                                        <input type="hidden"
                                               name="categoryId"
                                               value="@category.CategoryId" />

                                        <button type="submit"
                                                class="btn btn-primary w-100">
                                            Enrol
                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>