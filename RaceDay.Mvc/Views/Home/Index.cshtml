@model List<RaceDay.Mvc.Models.EventViewModel>

@{
    ViewData["Title"] = "RaceDay";

    var role = Context.Session.GetString("Role");
    var email = Context.Session.GetString("Email");
    var isParticipant =
        string.Equals(role, "Participant", StringComparison.OrdinalIgnoreCase);
}

@if (!isParticipant)
{
    <style>
        .rd-home {
            --rd-ink: #092b3b;
            --rd-teal: #0f5158;
            --rd-lime: #d5fb8b;
            color: var(--rd-ink);
        }

            .rd-home .rd-hero {
                position: relative;
                isolation: isolate;
                overflow: hidden;
                border-radius: 25px;
                min-height: 460px;
                display: flex;
                align-items: center;
                background: linear-gradient(90deg, rgba(1,31,43,.96) 0%, rgba(1,37,51,.87) 43%, rgba(0,70,103,.30) 100%), url('https://images.unsplash.com/photo-1552674605-db6ffd4facb5?auto=format&fit=crop&w=1800&q=85') center 48% / cover;
            }

            .rd-home .rd-hero-content {
                padding: clamp(32px, 6vw, 75px);
                max-width: 690px;
                color: white;
            }

            .rd-home .rd-kicker {
                display: inline-block;
                font-size: .78rem;
                font-weight: 800;
                letter-spacing: .09em;
                color: var(--rd-lime);
                background: rgba(213,251,139,.12);
                border: 1px solid rgba(213,251,139,.4);
                padding: 9px 16px;
                border-radius: 30px;
            }

            .rd-home .rd-hero h1 {
                font-size: clamp(2.45rem, 5vw, 4.3rem);
                line-height: 1.06;
                letter-spacing: -.045em;
                font-weight: 850;
                margin: 26px 0 20px;
            }

            .rd-home .rd-hero p {
                font-size: 1.08rem;
                line-height: 1.8;
                max-width: 530px;
            }

            .rd-home .rd-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 13px 22px;
                border-radius: 11px;
                font-weight: 800;
                text-decoration: none;
                transition: transform .15s ease;
            }

                .rd-home .rd-button:hover {
                    transform: translateY(-2px);
                }

            .rd-home .rd-button-lime {
                background: var(--rd-lime);
                color: #092b3b;
            }

            .rd-home .rd-button-outline {
                border: 1px solid rgba(255,255,255,.8);
                color: white;
            }

                .rd-home .rd-button-outline:hover {
                    background: rgba(255,255,255,.13);
                    color: white;
                }

            .rd-home .rd-login-link {
                color: var(--rd-lime);
                font-weight: 800;
            }

            .rd-home .rd-section {
                padding: 72px 0 12px;
            }

            .rd-home .rd-eyebrow {
                font-size: .78rem;
                font-weight: 850;
                letter-spacing: .15em;
                text-transform: uppercase;
                color: #007a7a;
            }

            .rd-home .rd-section-title {
                font-weight: 850;
                letter-spacing: -.035em;
                font-size: clamp(1.8rem, 3.5vw, 2.7rem);
            }

            .rd-home .rd-muted {
                color: #567082;
                line-height: 1.8;
            }

            .rd-home .rd-activity {
                border: 1px solid #e1e9eb;
                border-radius: 20px;
                overflow: hidden;
                height: 100%;
                background: #fff;
                box-shadow: 0 10px 35px rgba(4,42,54,.06);
            }

                .rd-home .rd-activity img {
                    width: 100%;
                    height: 200px;
                    object-fit: cover;
                    display: block;
                }

            .rd-home .rd-activity-body {
                padding: 25px;
            }

            .rd-home .rd-activity h3 {
                font-weight: 800;
                font-size: 1.35rem;
            }

            .rd-home .rd-wellness {
                margin-top: 70px;
                padding: clamp(28px, 5vw, 55px);
                background: #edf7f1;
                border-radius: 24px;
            }

                .rd-home .rd-wellness h2 {
                    font-weight: 850;
                    letter-spacing: -.035em;
                }

            .rd-home .rd-benefit {
                padding: 16px 0;
                border-bottom: 1px solid #ccdfd7;
            }

                .rd-home .rd-benefit:last-child {
                    border-bottom: 0;
                }

                .rd-home .rd-benefit strong {
                    display: block;
                    margin-bottom: 6px;
                }

            .rd-home .rd-cta {
                margin: 58px 0 30px;
                border-radius: 24px;
                padding: 46px 22px;
                background: #103e45;
                color: white;
                text-align: center;
            }

                .rd-home .rd-cta h2 {
                    font-weight: 850;
                }

        @@media (max-width: 575px) {
            .rd-home .rd-hero {
                min-height: 500px;
            }

            .rd-home .rd-hero-content {
                padding: 32px 24px;
            }

            .rd-home .rd-hero h1 {
                font-size: 2.5rem;
            }

            .rd-home .rd-activity img {
                height: 180px;
            }
        }
    </style>

    <div class="rd-home py-3">
        <section class="rd-hero" aria-labelledby="rd-hero-title">
            <div class="rd-hero-content">
                <span class="rd-kicker">MOVE MORE. FEEL BETTER. TOGETHER.</span>
                <h1 id="rd-hero-title">Every step starts something great.</h1>
                <p>Find your next run, enjoy a refreshing walk, and connect with a community that celebrates every finish line. Your pace. Your journey. Your RaceDay.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Account" asp-action="Register" class="rd-button rd-button-lime">Get Started</a>
                    <a asp-controller="Home" asp-action="ExploreEvents" class="rd-button rd-button-outline">Explore Events</a>
                </div>
                <p class="mt-3 mb-0" style="font-size: .95rem;">Already have an account? <a asp-controller="Account" asp-action="Login" class="rd-login-link">Log in</a></p>
            </div>
        </section>

        <section class="rd-section text-center" aria-labelledby="rd-movement-title">
            <div class="rd-eyebrow mb-3">FIND YOUR KIND OF MOVEMENT</div>
            <h2 id="rd-movement-title" class="rd-section-title">There's a RaceDay for everyone.</h2>
            <p class="rd-muted mx-auto mt-3 mb-4" style="max-width: 690px;">Whether you're chasing a personal best or simply enjoying the outdoors, every journey deserves a starting line.</p>
            <div class="row g-4 text-start mt-2">
                <div class="col-md-4">
                    <article class="rd-activity">
                        <img src="https://images.unsplash.com/photo-1552674605-db6ffd4facb5?auto=format&fit=crop&w=800&q=80" alt="People enjoying a run outdoors" loading="lazy" />
                        <div class="rd-activity-body"><h3>Running events</h3><p class="rd-muted mb-0">Find your rhythm, set your own goals, and enjoy the energy of race day.</p></div>
                    </article>
                </div>
                <div class="col-md-4">
                    <article class="rd-activity">
                        <img src="https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?auto=format&fit=crop&w=800&q=80" alt="Outdoor walking and movement" loading="lazy" />
                        <div class="rd-activity-body"><h3>Walking events</h3><p class="rd-muted mb-0">Take a breath, enjoy the scenery, and move at a pace that feels right for you.</p></div>
                    </article>
                </div>
                <div class="col-md-4">
                    <article class="rd-activity">
                        <img src="https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=800&q=80" alt="Swimming as a form of fitness and wellbeing" loading="lazy" />
                        <div class="rd-activity-body"><h3>More ways to move</h3><p class="rd-muted mb-0">Discover activities that help you stay active, build confidence, and connect.</p></div>
                    </article>
                </div>
            </div>
        </section>

        <section class="rd-wellness" aria-labelledby="rd-wellness-title">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <div class="rd-eyebrow mb-3">MOVEMENT FOR YOUR MIND</div>
                    <h2 id="rd-wellness-title" class="mb-3">A little movement can make a big difference.</h2>
                    <p class="rd-muted">Running and walking are about more than distance. Regular physical activity can support mood, reduce stress, improve sleep and create opportunities to connect with others.</p>
                    <p class="rd-muted mb-0">You don't have to be the fastest. Showing up and taking the next step is already worth celebrating.</p>
                </div>
                <div class="col-lg-6">
                    <div class="rd-benefit"><strong>Clear your mind</strong><span class="rd-muted">Make space in your day to unwind and reset.</span></div>
                    <div class="rd-benefit"><strong>Build confidence</strong><span class="rd-muted">Set personal goals and celebrate progress at your own pace.</span></div>
                    <div class="rd-benefit"><strong>Feel connected</strong><span class="rd-muted">Move alongside a welcoming community of people with shared interests.</span></div>
                </div>
            </div>
        </section>

        <section class="rd-cta" aria-labelledby="rd-cta-title">
            <h2 id="rd-cta-title">Your next great day starts here.</h2>
            <p>Join RaceDay, discover events and make every step count.</p>
            <a asp-controller="Account" asp-action="Register" class="rd-button rd-button-lime mt-2">Create Your Account</a>
            <p class="mt-3 mb-0">Already have an account? <a asp-controller="Account" asp-action="Login" class="rd-login-link">Log in</a></p>
        </section>
    </div>
}
else
{
    var eventCards = ViewBag.EventCards as Dictionary<int, RaceDay.Mvc.Models.EventCardViewModel>
        ?? new Dictionary<int, RaceDay.Mvc.Models.EventCardViewModel>();
    <div class="py-4">
        <!-- PARTICIPANT DASHBOARD HEADER -->
        <div class="mb-4">
            <h1 class="fw-bold">Participant Dashboard</h1>
            <p class="text-muted mb-0">Welcome, @email</p>
            <p class="text-muted">Browse the available RaceDay events below.</p>
        </div>

        <!-- API ERROR MESSAGE -->
        @if (ViewBag.EventError != null)
        {
            <div class="alert alert-danger">@ViewBag.EventError</div>
        }

        <!-- DASHBOARD SUMMARY -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Available Events</h6>
                        <h2 class="fw-bold">@(Model?.Count ?? 0)</h2>
                        <p class="mb-0">Events currently available.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Account Role</h6>
                        <h4 class="fw-bold">Participant</h4>
                        <p class="mb-0">Participant access enabled.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">RaceDay Account</h6>
                        <h4 class="fw-bold">Active</h4>
                        <p class="mb-0">@email</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- PARTICIPANT QUICK ACTIONS -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-2">My RaceDay Activity</h5>

                <p class="text-muted">
                    Manage your event enrolments and view your
                    published race results.
                </p>

                <div class="d-flex flex-wrap gap-2">

                    <a asp-controller="Home"
                       asp-action="MyEnrolments"
                       class="btn btn-outline-primary">
                        My Enrolments
                    </a>

                    <a asp-controller="Home"
                       asp-action="MyResults"
                       class="btn btn-success">
                        My Results
                    </a>

                </div>
            </div>
        </div>

         @if (ViewBag.CategoryWarning != null)
         {
             <div class="alert alert-warning" role="alert">@ViewBag.CategoryWarning</div>
         }

         <!-- AVAILABLE EVENTS AND FILTERS -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1">Available Events</h2>
                <p class="text-muted mb-0">Find an event by name, type, location or distance.</p>
            </div>
            <span class="badge bg-primary fs-6" id="eventCount" aria-live="polite">@(Model?.Count ?? 0) events</span>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-3 col-md-6">
                            <label for="eventSearch" class="form-label fw-semibold">Search events</label>
                            <input id="eventSearch" type="search" class="form-control" placeholder="Event name..." />
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="eventTypeFilter" class="form-label fw-semibold">Event type</label>
                            <select id="eventTypeFilter" class="form-select">
                                <option value="">All types</option>
                                @foreach (var eventType in Model.Select(e => e.EventType?.Trim()).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t))
                                {
                                    <option value="@eventType">@eventType</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label for="eventLocationFilter" class="form-label fw-semibold">Location</label>
                            <select id="eventLocationFilter" class="form-select">
                                <option value="">All locations</option>
                                @foreach (var location in Model.Select(e => e.Location?.Trim()).Where(l => !string.IsNullOrWhiteSpace(l)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(l => l))
                                {
                                    <option value="@location">@location</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="eventDistanceFilter" class="form-label fw-semibold">Maximum distance</label>
                            <select id="eventDistanceFilter" class="form-select">
                                <option value="">Any distance</option>
                                <option value="5">Up to 5 km</option>
                                <option value="10">Up to 10 km</option>
                                <option value="21">Up to 21 km</option>
                                <option value="50">Up to 50 km</option>
                                <option value="100">Up to 100 km</option>
                            </select>
                        </div>
                         <div class="col-lg-12">
                             <div class="form-check">
                                 <input class="form-check-input" type="checkbox" id="eligibleOnlyFilter" />
                                 <label class="form-check-label fw-semibold" for="eligibleOnlyFilter">Eligible events only</label>
                                 <div class="form-text">Show events with at least one category matching your age on event day.</div>
                             </div>
                         </div>
                         <div class="col-12">
    <button id="clearEventFilters" type="button" class="btn btn-outline-secondary" style="min-width: 100px; white-space: nowrap;">Clear</button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="noMatchingEvents" class="alert alert-info d-none" role="status">No events match your filters. Try clearing one or more filters.</div>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info mt-3">No RaceDay events are currently available.</div>
        }
        else
        {
            <div class="row">
                @foreach (var raceEvent in Model)
                {
                    eventCards.TryGetValue(raceEvent.EventId, out var eventCard);
                    var categories = eventCard?.Categories ?? new List<RaceDay.Mvc.Models.CategoryViewModel>();
                    var participantAge = eventCard?.ParticipantAgeOnEventDate;
                    var eligibleEvent = eventCard?.HasEligibleCategory == true;
                    <div class="col-lg-4 col-md-6 mb-4 rd-filterable-event"
                         data-eligible="@(eligibleEvent ? "true" : "false")"
                         data-name="@raceEvent.EventName"

                         data-type="@raceEvent.EventType"
                         data-location="@raceEvent.Location"
                         data-distance="@raceEvent.DistanceKm.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <div class="card shadow-sm h-100">
                            @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageUrl))
                            {
                                <img src="@raceEvent.BannerImageUrl"
                                     class="card-img-top"
                                     alt="@raceEvent.EventName"
                                     style="height: 200px; object-fit: cover;" />
                            }
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2"><span class="badge bg-primary">@raceEvent.EventType</span></div>
                                <h4 class="card-title fw-bold">@raceEvent.EventName</h4>
                                @if (!string.IsNullOrWhiteSpace(raceEvent.Description))
                                {
                                    <p class="card-text text-muted">@raceEvent.Description</p>
                                }
                                <div class="mt-2">
                                    <p class="mb-2"><strong>Date:</strong> @raceEvent.EventDate.ToString("dd MMMM yyyy")</p>
                                    <p class="mb-2"><strong>Location:</strong> @raceEvent.Location</p>
                                    <p class="mb-2"><strong>Distance:</strong> @raceEvent.DistanceKm km</p>
                                </div>
                                 <div class="mt-3">
                                     <h6 class="fw-bold mb-2">Event categories</h6>
                                     @if (categories.Count == 0)
                                     {
                                         <p class="text-muted small mb-2">No categories available yet.</p>
                                     }
                                     else
                                     {
                                         @foreach (var category in categories)
                                         {
                                             bool canEnrol = participantAge.HasValue &&
                                                 participantAge.Value >= category.MinAge &&
                                                 participantAge.Value <= category.MaxAge;
                                             <div class="border rounded p-2 mb-2 small">
                                                 <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                     <strong>@category.CategoryName</strong>
                                                     @if (!participantAge.HasValue)
                                                     {
                                                         <span class="badge bg-secondary">Age unavailable</span>
                                                     }
                                                     else if (canEnrol)
                                                     {
                                                         <span class="badge bg-success">Eligible</span>
                                                     }
                                                     else
                                                     {
                                                         <span class="badge bg-secondary">Not eligible</span>
                                                     }
                                                 </div>
                                                 <div class="text-muted">Ages @category.MinAge–@category.MaxAge · @category.DistanceKm km</div>
                                             </div>
                                         }
                                     }
                                 </div>
                                 <div class="mt-auto pt-3">
                                     <a asp-controller="Home"
                                       asp-action="EventDetails"
                                       asp-route-id="@raceEvent.EventId"
                                       class="btn btn-primary w-100">View Event</a>
                                </div>
                            </div>
                            <div class="card-footer bg-white text-muted">Event ID: @raceEvent.EventId</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const cards = Array.from(document.querySelectorAll('.rd-filterable-event'));
        if (!cards.length) return;
        const search = document.getElementById('eventSearch');
        const type = document.getElementById('eventTypeFilter');
        const location = document.getElementById('eventLocationFilter');
        const distance = document.getElementById('eventDistanceFilter');
        const count = document.getElementById('eventCount');
        const empty = document.getElementById('noMatchingEvents');
         const clear = document.getElementById('clearEventFilters');
         const eligibleOnly = document.getElementById('eligibleOnlyFilter');
        const norm = value => (value || '').trim().toLocaleLowerCase();

        function applyFilters() {
            let visible = 0;
            cards.forEach(card => {
                const nameMatch = norm(card.dataset.name).includes(norm(search.value));
                const typeMatch = !type.value || norm(card.dataset.type) === norm(type.value);
                const locationMatch = !location.value || norm(card.dataset.location) === norm(location.value);
                const eventDistance = Number(card.dataset.distance);
                const distanceMatch = !distance.value || (Number.isFinite(eventDistance) && eventDistance <= Number(distance.value));
                 const eligibilityMatch = !eligibleOnly.checked || card.dataset.eligible === 'true';
                 const show = nameMatch && typeMatch && locationMatch && distanceMatch && eligibilityMatch;
                card.classList.toggle('d-none', !show);
                if (show) visible++;
            });
            count.textContent = `${visible} of ${cards.length} events`;
            empty.classList.toggle('d-none', visible !== 0);
        }

         [search, type, location, distance, eligibleOnly].forEach(control => {
            control.addEventListener(control === search ? 'input' : 'change', applyFilters);
        });
        clear.addEventListener('click', function () {
            search.value = '';
            type.value = '';
            location.value = '';
             distance.value = '';
             eligibleOnly.checked = false;
             applyFilters();
        });
        applyFilters();
    });
</script>
