
@model List<RaceDay.Mvc.Models.EventViewModel>

@{
    ViewData["Title"] = "Explore Events";
}

<style>
    .explore-page {
        --race-ink: #092b3b;
        --race-teal: #0f5158;
        --race-lime: #d5fb8b;
    }

    .explore-header {
        background: linear-gradient(120deg, #092b3b, #0f5158);
        color: white;
        border-radius: 22px;
        padding: 48px 35px;
        margin-bottom: 35px;
    }

    .explore-header h1 {
        font-weight: 800;
        letter-spacing: -0.035em;
    }

    .explore-header p {
        color: #d7e8e9;
        max-width: 650px;
        line-height: 1.7;
    }

    .explore-event-card {
        border: 1px solid #e0e8eb;
        border-radius: 18px;
        overflow: hidden;
        height: 100%;
        background: white;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .explore-event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(9,43,59,.12);
    }

    .explore-event-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        display: block;
    }

    .explore-event-placeholder {
        height: 210px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #0f5158, #092b3b);
        color: white;
        font-weight: 700;
        font-size: 1.3rem;
    }

    .explore-event-body {
        padding: 24px;
    }

    .explore-event-body h2 {
        font-size: 1.35rem;
        font-weight: 800;
        color: #092b3b;
    }

    .explore-event-meta {
        color: #536a75;
        line-height: 1.9;
    }

    .explore-view-button {
        background: #0f5158;
        color: white;
        border-radius: 10px;
        padding: 12px 18px;
        font-weight: 700;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .explore-view-button:hover {
        background: #092b3b;
        color: white;
    }
</style>

<div class="explore-page py-4">

    <section class="explore-header">
        <h1>Explore RaceDay Events</h1>

        <p class="mb-3">
            Discover upcoming runs, walks and cycling events.
            Browse events and find your next challenge.
            No account is required to explore.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-light">
            Back to Home
        </a>
    </section>

    @if (ViewBag.EventError != null)
    {
        <div class="alert alert-danger">
            @ViewBag.EventError
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Available Events</h2>

            <p class="text-muted mb-0">
                Select an event to view its details and categories.
            </p>
        </div>

        <span class="badge bg-secondary fs-6">
            @(Model?.Count ?? 0) Events
        </span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No RaceDay events are currently available.
            Please check again later.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <article class="explore-event-card d-flex flex-column">

                        @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageUrl))
                        {
                            <img src="@raceEvent.BannerImageUrl"
                                 class="explore-event-image"
                                 alt="@raceEvent.EventName"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="explore-event-placeholder">
                                RaceDay Event
                            </div>
                        }

                        <div class="explore-event-body d-flex flex-column flex-grow-1">

                            <div class="mb-3">
                                <span class="badge bg-success">
                                    @raceEvent.EventType
                                </span>
                            </div>

                            <h2>@raceEvent.EventName</h2>

                            @if (!string.IsNullOrWhiteSpace(raceEvent.Description))
                            {
                                <p class="text-muted">
                                    @raceEvent.Description
                                </p>
                            }

                            <div class="explore-event-meta mt-2">
                                <div>
                                    <strong>Date:</strong>
                                    @raceEvent.EventDate.ToString("dd MMMM yyyy")
                                </div>

                                <div>
                                    <strong>Location:</strong>
                                    @raceEvent.Location
                                </div>

                                <div>
                                    <strong>Distance:</strong>
                                    @raceEvent.DistanceKm km
                                </div>
                            </div>

                            <div class="mt-auto pt-4">

                                <a asp-controller="Home"
                                   asp-action="PublicEventDetails"
                                   asp-route-id="@raceEvent.EventId"
                                   class="explore-view-button">
                                    View Event Details
                                </a>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>
