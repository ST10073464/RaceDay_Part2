@model List<RaceDay.Mvc.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";

    var enrolments = Model ?? new List<RaceDay.Mvc.Models.EnrolmentViewModel>();

    int totalEnrolments = enrolments.Count;

    int confirmedEnrolments = enrolments.Count(e =>
        string.Equals(e.EnrolmentStatus, "Confirmed",
            StringComparison.OrdinalIgnoreCase));

    int cancelledEnrolments = enrolments.Count(e =>
        string.Equals(e.EnrolmentStatus, "Cancelled",
            StringComparison.OrdinalIgnoreCase));

    int pendingEnrolments = enrolments.Count(e =>
        string.Equals(e.EnrolmentStatus, "Pending",
            StringComparison.OrdinalIgnoreCase));
}

<div class="container mt-4">

    <div class="mb-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>
    </div>

    <div class="mb-3">
        <h2 class="mb-1">My Enrolments</h2>
        <p class="text-muted mb-0">
            View and manage the RaceDay events you have enrolled in.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["EnrolmentSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["EnrolmentSuccess"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["EnrolmentError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["EnrolmentError"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (ViewBag.EnrolmentError != null)
    {
        <div class="alert alert-danger">
            @ViewBag.EnrolmentError
        </div>
    }

    @if (ViewBag.EnrolmentError == null)
    {
        <!-- PARTICIPANT ENROLMENT STATISTICS -->
        <div class="row g-3 mb-4">

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 border-primary">
                    <div class="card-body">
                        <div class="text-muted small mb-1">
                            Total Enrolments
                        </div>
                        <h3 class="mb-0 text-primary">
                            @totalEnrolments
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-body">
                        <div class="text-muted small mb-1">
                            Confirmed
                        </div>
                        <h3 class="mb-0 text-success">
                            @confirmedEnrolments
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 border-danger">
                    <div class="card-body">
                        <div class="text-muted small mb-1">
                            Cancelled
                        </div>
                        <h3 class="mb-0 text-danger">
                            @cancelledEnrolments
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card shadow-sm h-100 border-warning">
                    <div class="card-body">
                        <div class="text-muted small mb-1">
                            Pending
                        </div>
                        <h3 class="mb-0 text-warning">
                            @pendingEnrolments
                        </h3>
                    </div>
                </div>
            </div>

        </div>

        <!-- EXISTING ENROLMENT CARDS -->
        @if (enrolments.Any())
        {
            <div class="row">

                @foreach (var enrolment in enrolments)
                {
                    <div class="col-md-6 col-lg-4 mb-4">

                        <div class="card h-100 shadow-sm">

                            <div class="card-header">
                                <h5 class="mb-0">
                                    @enrolment.EventName
                                </h5>
                            </div>

                            <div class="card-body">

                                <p class="mb-2">
                                    <strong>Category:</strong><br />
                                    @enrolment.CategoryName
                                </p>

                                <p class="mb-2">
                                    <strong>Enrolment Date:</strong><br />
                                    @enrolment.EnrolmentDate.ToString("dd MMMM yyyy")
                                </p>

                                <p class="mb-3">
                                    <strong>Status:</strong><br />

                                    @if (string.Equals(
                                        enrolment.EnrolmentStatus,
                                        "Confirmed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            @enrolment.EnrolmentStatus
                                        </span>
                                    }
                                    else if (string.Equals(
                                        enrolment.EnrolmentStatus,
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @enrolment.EnrolmentStatus
                                        </span>
                                    }
                                    else if (string.Equals(
                                        enrolment.EnrolmentStatus,
                                        "Cancelled",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">
                                            @enrolment.EnrolmentStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @enrolment.EnrolmentStatus
                                        </span>
                                    }
                                </p>

                                <div class="d-grid gap-2">

                                    <a asp-controller="Home"
                                       asp-action="EventDetails"
                                       asp-route-id="@enrolment.EventId"
                                       class="btn btn-outline-primary">
                                        View Event
                                    </a>

                                    @if (!string.Equals(
                                        enrolment.EnrolmentStatus,
                                        "Cancelled",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-controller="Home"
                                              asp-action="CancelEnrolment"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="enrolmentId"
                                                   value="@enrolment.EnrolmentId" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger w-100">
                                                Cancel Enrolment
                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                            <div class="card-footer text-muted">
                                Enrolment ID: @enrolment.EnrolmentId
                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-info">
                <h5>No enrolments yet</h5>
                <p class="mb-3">
                    You have not enrolled in any RaceDay events yet.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">
                    Browse Available Events
                </a>
            </div>
        }
    }

</div>
