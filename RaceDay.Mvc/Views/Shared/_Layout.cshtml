@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    string? userEmail =
        HttpContextAccessor.HttpContext?.Session.GetString("Email");

    string? userRole =
        HttpContextAccessor.HttpContext?.Session.GetString("Role");

    bool isLoggedIn = !string.IsNullOrWhiteSpace(userEmail);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDay.Mvc.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm
            navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    RaceDay
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse
                    d-sm-inline-flex
                    justify-content-between">

                    <!-- LEFT SIDE -->
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (isLoggedIn &&
                         string.Equals(
                             userRole,
                             "Participant",
                             StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Home"
                                   asp-action="MyEnrolments">
                                    My Enrolments
                                </a>
                            </li>
                        }
                        
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- RIGHT SIDE -->
                    <ul class="navbar-nav">

                        @if (isLoggedIn)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-dark">
                                    <strong>@userRole</strong>
                                </span>
                            </li>

                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-muted">
                                    @userEmail
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link text-dark">
                                        Logout
                                    </button>

                                </form>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">

        <main role="main" class="pb-3">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>
            }

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>